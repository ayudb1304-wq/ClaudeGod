# ClaudeGod build-time configuration.
#
# NO SECRETS BELONG IN THIS FILE OR IN ANY .env THAT FEEDS THE BUILD.
# Everything Vite inlines as VITE_* ends up readable inside the shipped CRX.
#
# In particular: do NOT add a Dodo Payments API key. The license endpoints
# (activate/validate/deactivate) are public and take no authentication. The API
# key exists for server-side admin calls this extension never makes.

# "test" points the license client at https://test.dodopayments.com.
# Anything else (including unset) means live. Ship builds are live.
VITE_DODO_ENV=test

# Hosted Dodo checkout link shown as the upgrade CTA. Public URL.
# Leave empty and the upgrade link is hidden rather than pointing nowhere.
VITE_DODO_CHECKOUT_URL=

# One-question uninstall feedback form on the landing domain. Public URL.
VITE_UNINSTALL_URL=

# "1" compiles in the dev-hooks postMessage bridge for manual verification.
# Never set this for a build you intend to publish.
VITE_DEV_HOOKS=

# ---------------------------------------------------------------------------
# LOCAL TOOLING ONLY — never VITE_-prefixed, never read from src/.
# ---------------------------------------------------------------------------
# Dodo TEST-mode API key, used solely by scripts/dodo-setup.mjs on your machine
# to create the test product and licence key. Vite only inlines VITE_* vars, so
# this cannot reach the extension bundle, and a guard test enforces that src/
# never reads process.env or this name.
DODO_API_KEY=
